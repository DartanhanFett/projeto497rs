---
/**
 * Galeria de fotos com lightbox interativo.
 *
 * Modo padrão: grid de thumbnails (mesma aparência da galeria anterior).
 * Click numa foto → abre lightbox fullscreen.
 *
 * Lightbox suporta:
 *   - Click direita/esquerda da foto → próxima/anterior (UX mobile)
 *   - Setas do teclado (← →) e Esc — desktop
 *   - Swipe lateral em mobile (touch)
 *   - Pinch to zoom (nativo do browser via touch)
 *   - Indicador "N / total"
 *   - Lazy loading das fotos não-visíveis
 *
 * Vanilla JS, ~3KB, zero dependências.
 */

interface Props {
  fotos: string[];
  /** Texto base usado como alt das imagens. */
  legenda: string;
}

const { fotos, legenda } = Astro.props;

if (fotos.length === 0) return null;
---

<section
  class="galeria"
  data-galeria
  data-fotos={JSON.stringify(fotos)}
  data-legenda={legenda}
>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
    {fotos.map((url, i) => (
      <button
        type="button"
        data-galeria-thumb
        data-index={i}
        class="aspect-[9/16] rounded-xl overflow-hidden border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors block bg-[var(--color-surface)] cursor-pointer"
        aria-label={`Abrir foto ${i + 1} de ${fotos.length}`}
      >
        <img
          src={url}
          alt={`${legenda} — foto ${i + 1}`}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </button>
    ))}
  </div>

  <!-- Lightbox (oculto por padrão). Escala a partir do thumbnail clicado. -->
  <div
    data-galeria-lightbox
    class="hidden fixed inset-0 z-50 bg-black/95 select-none"
    role="dialog"
    aria-modal="true"
    aria-label="Visualizador de fotos"
  >
    <!-- Header com contador + fechar -->
    <div class="absolute top-0 inset-x-0 z-10 flex items-center justify-between p-4 text-white pointer-events-none">
      <span data-galeria-counter class="text-sm font-medium tabular-nums bg-black/40 rounded-full px-3 py-1 backdrop-blur-sm pointer-events-auto">
        1 / {fotos.length}
      </span>
      <button
        type="button"
        data-galeria-close
        class="w-10 h-10 flex items-center justify-center rounded-full bg-black/40 hover:bg-black/70 transition-colors pointer-events-auto"
        aria-label="Fechar visualizador"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Foto + zonas de toque (esquerda = anterior, direita = próxima) -->
    <div class="absolute inset-0 flex items-center justify-center">
      <img
        data-galeria-img
        src=""
        alt=""
        class="max-w-[100vw] max-h-[100dvh] object-contain"
        draggable="false"
      />
    </div>

    <!-- Zonas clicáveis sobrepostas (não bloqueiam pinch zoom porque
         têm pointer-events só em click/tap, e usam touch-action manipulation) -->
    <button
      type="button"
      data-galeria-prev
      class="absolute left-0 top-0 bottom-0 w-1/3 flex items-center justify-start pl-2 sm:pl-4 group focus-visible:outline-none"
      style="touch-action: manipulation;"
      aria-label="Foto anterior"
    >
      <span class="w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center rounded-full bg-black/30 group-hover:bg-black/60 group-focus-visible:bg-black/60 text-white opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 sm:opacity-70 transition-opacity">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </span>
    </button>

    <button
      type="button"
      data-galeria-next
      class="absolute right-0 top-0 bottom-0 w-1/3 flex items-center justify-end pr-2 sm:pr-4 group focus-visible:outline-none"
      style="touch-action: manipulation;"
      aria-label="Próxima foto"
    >
      <span class="w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center rounded-full bg-black/30 group-hover:bg-black/60 group-focus-visible:bg-black/60 text-white opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 sm:opacity-70 transition-opacity">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </span>
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-galeria]").forEach((root) => {
    const fotos: string[] = JSON.parse(root.dataset.fotos || "[]");
    const legenda = root.dataset.legenda || "";
    if (fotos.length === 0) return;

    const lightbox = root.querySelector<HTMLElement>("[data-galeria-lightbox]")!;
    const img = root.querySelector<HTMLImageElement>("[data-galeria-img]")!;
    const counter = root.querySelector<HTMLElement>("[data-galeria-counter]")!;
    const closeBtn = root.querySelector<HTMLButtonElement>("[data-galeria-close]")!;
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-galeria-prev]")!;
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-galeria-next]")!;
    const thumbs = root.querySelectorAll<HTMLButtonElement>("[data-galeria-thumb]");

    let atual = 0;
    let prevFocus: HTMLElement | null = null;

    function mostrar(i: number) {
      atual = (i + fotos.length) % fotos.length; // wrap-around
      img.src = fotos[atual];
      img.alt = `${legenda} — foto ${atual + 1}`;
      counter.textContent = `${atual + 1} / ${fotos.length}`;
      preloadVizinhas();
    }

    /** Pré-carrega a próxima e a anterior pra navegação suave. */
    function preloadVizinhas() {
      for (const offset of [1, -1]) {
        const i = (atual + offset + fotos.length) % fotos.length;
        const im = new Image();
        im.src = fotos[i];
      }
    }

    function abrir(i: number) {
      prevFocus = document.activeElement as HTMLElement;
      mostrar(i);
      lightbox.classList.remove("hidden");
      // Bloqueia scroll do body enquanto aberto
      document.body.style.overflow = "hidden";
      // Foco no botão fechar pra acessibilidade
      closeBtn.focus();
    }

    function fechar() {
      lightbox.classList.add("hidden");
      document.body.style.overflow = "";
      // Devolve foco pro thumbnail original (acessibilidade)
      prevFocus?.focus();
    }

    // Click nos thumbnails
    thumbs.forEach((btn, i) => {
      btn.addEventListener("click", () => abrir(i));
    });

    // Navegação por click nas zonas
    prevBtn.addEventListener("click", () => mostrar(atual - 1));
    nextBtn.addEventListener("click", () => mostrar(atual + 1));
    closeBtn.addEventListener("click", fechar);

    // Teclado (só quando lightbox aberto)
    document.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") fechar();
      else if (e.key === "ArrowRight") mostrar(atual + 1);
      else if (e.key === "ArrowLeft") mostrar(atual - 1);
    });

    // Swipe lateral em mobile
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartTime = 0;
    img.addEventListener("touchstart", (e) => {
      if (e.touches.length !== 1) return; // ignora pinch
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
      touchStartTime = Date.now();
    }, { passive: true });

    img.addEventListener("touchend", (e) => {
      if (e.changedTouches.length !== 1) return;
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      const dt = Date.now() - touchStartTime;
      // Swipe horizontal: > 50px, dominante sobre vertical, < 500ms
      if (dt < 500 && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) mostrar(atual + 1);
        else mostrar(atual - 1);
      }
    }, { passive: true });
  });
</script>
