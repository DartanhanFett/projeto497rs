# ──────────────────────────────────────────────────────────────────
# Variáveis de ambiente — Cloudflare R2
# ──────────────────────────────────────────────────────────────────
# Copie este arquivo para `.env` e preencha com seus valores.
# `.env` está no .gitignore — nunca será commitado.
#
# Esses valores vêm da etapa 4 do docs/SETUP-R2.md.

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=projeto497rs-midia
R2_PUBLIC_URL=https://cdn.projeto497rs.com.br
